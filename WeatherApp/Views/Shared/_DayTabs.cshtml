@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoWeatherData

@{
    string waterColor = WeatherHelper.GetWaterDarkColor();

    int dayOffset = (int)(ViewData["DayOffset"] ?? 0);
    DateTime localNow = DateTime.UtcNow.AddSeconds(Model.UtcOffsetSeconds);
    DateTime selectedDayDate = localNow.AddDays(dayOffset).Date;

    int minDayIndex = -WeatherHelper.PastDays;
    int maxDayIndex = WeatherHelper.Days - 1;
    int startDayIndex = -1;
    if (dayOffset < minDayIndex + 1)
    {
        startDayIndex = 0;
    }
    if (dayOffset > maxDayIndex - 2)
    {
        startDayIndex = maxDayIndex - 3 - dayOffset;
    }
    int endDayIndex = startDayIndex + 4;

    var location = ViewData["Location"] as Location;
    var locationWithId = $"{location.Name}-{location.Id}";

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
    string precipUnit = Context.Request.Cookies["precipUnit"] ?? WeatherHelper.DefaultPrecipUnit;
}

<div class="d-flex gap-2">
    @for (int i = startDayIndex; i < endDayIndex; i++)
    {
        var day = Model.DailyWeatherData.GetSingleDayWeather(selectedDayDate.AddDays(i));
        var svgPair = WeatherHelper.GetWeatherSvgPair(day.Code);
        var weatherDescription = WeatherHelper.GetWeatherDescription(day.Code);

        <a asp-action="Day" asp-route-city="@locationWithId" asp-route-day="@(dayOffset + i)" class="text-decoration-none text-black">
            <div class="p-2 mb-2 pt-1 rounded bg-white @(i == 0 && ViewData["DayOffset"] != null ? "active-day-tab" : "day-tab")">
                <div class="d-flex justify-content-between h-100">
                    <div class="d-flex flex-column me-2">
                        <div style="height: 24px; font-size: 18px">
                            <date date="@selectedDayDate.AddDays(i)" format="dayWeekdayMonthShort"></date>
                        </div>
                        @{
                            var dayIndex = dayOffset + i;
                            var dayLabel = WeatherHelper.GetDayLabel(dayIndex);
                        }
                        <div class="text-secondary" style="height: 20px; font-size: 16px;">@dayLabel</div>
                        <div class="flex-grow-1"></div>
                        <div class="d-flex" style="font-size: 22px">
                            @{
                                string tempMinColor = WeatherHelper.GetTemperatureColor(day.TemperatureMin);
                                string tempMaxColor = WeatherHelper.GetTemperatureColor(day.TemperatureMax);
                            }
                            <div class="text-center" style="width: 65px; background-color:@tempMinColor;">
                                <temperature value="@day.TemperatureMin" unit="@temperatureUnit"></temperature>
                            </div>
                            <div class="text-center" style="width: 65px; background-color:@tempMaxColor;">
                                <temperature value="@day.TemperatureMax" unit="@temperatureUnit"></temperature>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-grow-1 text-center">
                        <div title="@weatherDescription">
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Clouds} d").svg" width="65" />
                            </div>
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Precipitation}").svg" width="42" />
                            </div>
                        </div>
                        <div class="flex-grow-1"></div>
                        <div style="color: @waterColor; visibility: @(day.PrecipitationSum == 0 ? "hidden" : "visible")">
                            <precipitation value="@day.PrecipitationSum" unit="@precipUnit"></precipitation>
                            <span>@precipUnit</span>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    }
</div>