@using WeatherApp.Helpers
@model WeatherApp.Models.OpenMeteoResponse
@{
    Dictionary<string, string> tabs = new()
        {
            {"Now", ""},
            {"Today", "today"},
            {"Tomorrow", "tomorrow"},
            {"3 days", "3days"},
            {"7 days", "7days"},
            {"2 weeks", "2weeks"},
            {"Month", "month"}
        };
}

<div class="mb-2" style="height: 130px;">
    <div class="p-2 pt-1 d-flex flex-column text-white rounded-bottom-3 h-100" style="background-color:#4e99e4">
        <div class="head-link-menu" style=" font-size: 16px">
            <a href="#">Ukraine</a> / <a href="#">Kyiv oblast</a> / <a href="#">Brovary raion</a>
        </div>
        <div class="fw-bold" style="font-size: 24px">
            @WeatherDescriptor.GetWeatherDescription(Model.CurrentWeather.Code) in @ViewData["City"], @((Model.CurrentWeather.Temperature > 0 ? "+" : "") + Model.CurrentWeather.Temperature) °C
        </div>
        <div class="flex-grow-1"></div>
        <div class="d-flex gap-4 head-link-menu">
            @foreach (var tab in tabs)
            {
                if (ViewData["ActiveTab"]!.Equals(tab.Key))
                {
                    <a class="link-active">@tab.Key</a>
                }
                else
                {
                    <a href="@tab.Value">@tab.Key</a>
                }
            }
        </div>
    </div>
</div>