@using WeatherApp.Helpers

@model WeatherApp.Models.OpenMeteoData

<div class="mb-2" style="height: 130px;">
    <div class="p-2 pt-1 d-flex flex-column text-white rounded-bottom-3 h-100" style="background-color:#4e99e4">
        <div class="head-link-menu" style=" font-size: 16px">
            <a href="#">Ukraine</a> / <a href="#">Kyiv oblast</a> / <a href="#">Brovary raion</a>
        </div>
        <div class="d-flex fw-bold" style="font-size: 24px">
            <div>@Model.CurrentWeatherData.WeatherDescription in @ViewData["City"],&nbsp;</div>
            <temperature value="@Model.CurrentWeatherData.Temperature"></temperature>
            <div>&nbsp;°C</div>
        </div>
        <div class="flex-grow-1"></div>
        <div class="d-flex gap-4 head-link-menu" id="navLinks" data-activetab="@ViewData["ActiveTab"]">
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="0" id="Yesterday">Yesterday</a>
            <a asp-action="Now" asp-route-city="@ViewData["City"]" id="Now">Now</a>
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="1" id="Today">Today</a>
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="2" id="Tomorrow">Tomorrow</a>
            <a asp-action="ThreeDays" asp-route-city="@ViewData["City"]" id="ThreeDays">3 days</a>
            <a asp-action="SevenDays" asp-route-city="@ViewData["City"]" id="SevenDays">7 days</a>
            <a asp-action="TwoWeeks" asp-route-city="@ViewData["City"]" id="TwoWeeks">2 weeks</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("navLinks");
        const activeTab = container.dataset.activetab;
        const link = container.querySelector(`#${activeTab}`);
        link.classList.add("link-active");
    });
</script>