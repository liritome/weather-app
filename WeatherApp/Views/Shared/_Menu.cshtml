@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoData

@{
    DateTime currentLocalTime = DateTime.UtcNow.AddSeconds(Model.UtcOffsetSeconds);
    DailyWeather weatherToday = Model.DailyWeatherData.GetDailyWeatherByDate(currentLocalTime);
    CurrentWeatherData currentWeather = Model.CurrentWeatherData;
    string weatherImage = WeatherHelper.GetWeatherImage(currentWeather.Code);
    DateTime sunrise = weatherToday.Sunrise;
    DateTime sunset = weatherToday.Sunset;
    bool isDay = currentLocalTime >= sunrise && currentLocalTime <= sunset;
}

<div class="mb-2 rounded-bottom-3 overflow-hidden" style="height: 130px; background-image: url('/images/weather/@($"{weatherImage} {(isDay ? "d" : "n")}").jpg'); background-size: cover; background-position: 0px -400px">
    <div class="p-2 pt-1 d-flex flex-column text-white h-100" style="background-color:rgba(0, 0, 0, 0.1);">
        <div class="head-link-menu" style=" font-size: 16px">
            <a href="#">Ukraine</a> / <a href="#">Kyiv oblast</a> / <a href="#">Brovary raion</a>
        </div>
        <div class="d-flex fw-bold" style="font-size: 24px">
            <div>@currentWeather.WeatherDescription in @ViewData["City"],&nbsp;</div>
            <temperature value="@currentWeather.Temperature"></temperature>
            <div>&nbsp;°C</div>
        </div>
        <div class="flex-grow-1"></div>
        <div class="d-flex gap-4 head-link-menu" id="navLinks" data-activetab="@ViewData["ActiveTab"]">
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="-1" id="Yesterday">Yesterday</a>
            <a asp-action="Now" asp-route-city="@ViewData["City"]" id="Now">Now</a>
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="0" id="Today">Today</a>
            <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="1" id="Tomorrow">Tomorrow</a>
            <a asp-action="ThreeDays" asp-route-city="@ViewData["City"]" id="ThreeDays">3 days</a>
            <a asp-action="SevenDays" asp-route-city="@ViewData["City"]" id="SevenDays">7 days</a>
            <a asp-action="TwoWeeks" asp-route-city="@ViewData["City"]" id="TwoWeeks">2 weeks</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("navLinks");
        const activeTab = container.dataset.activetab;
        const link = container.querySelector(`#${activeTab}`);
        link.classList.add("link-active");
    });
</script>