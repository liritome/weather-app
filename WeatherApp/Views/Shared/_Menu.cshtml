@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoWeatherData

@{
    DateTime currentLocalTime = DateTime.UtcNow.AddSeconds(Model.UtcOffsetSeconds);
    SingleDayWeather weatherToday = Model.DailyWeatherData.GetSingleDayWeather(currentLocalTime);
    CurrentWeatherData currentWeather = Model.CurrentWeatherData;
    string weatherImage = WeatherHelper.GetWeatherImage(currentWeather.Code);
    DateTime sunrise = weatherToday.Sunrise;
    DateTime sunset = weatherToday.Sunset;
    bool isDay = currentLocalTime >= sunrise && currentLocalTime <= sunset;
    string weatherDescription = WeatherHelper.GetWeatherDescription(currentWeather.Code);

    var location = ViewData["Location"] as Location;

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
}

<div class="mb-2 rounded-bottom-3 overflow-hidden" style="height: 130px; background-image: url('/images/weather/@($"{weatherImage} {(isDay ? "d" : "n")}").webp'); background-size: cover; background-position: 0px -400px">
    <div class="p-2 pt-1 d-flex flex-column text-white h-100" style="background-color:rgba(0, 0, 0, 0.1);">
        @{
            var pathParts = new List<string>();

            if (!string.IsNullOrWhiteSpace(location?.Country))
                pathParts.Add(location.Country);
            if (!string.IsNullOrWhiteSpace(location?.Admin1))
                pathParts.Add(location.Admin1);
            if (!string.IsNullOrWhiteSpace(location?.Admin2))
                pathParts.Add(location.Admin2);
            if (!string.IsNullOrWhiteSpace(location?.Admin3))
                pathParts.Add(location.Admin3);
            if (!string.IsNullOrWhiteSpace(location?.Admin4))
                pathParts.Add(location.Admin4);
            string fullPath = string.Join(" / ", pathParts);
        }
        <div class="head-link-menu" style=" font-size: 16px">
            @fullPath
        </div>
        <div class="d-flex fw-bold" style="font-size: 24px">
            <div>
                <span>@weatherDescription in @(location?.Name),&nbsp;</span>
            </div>
            <temperature value="@currentWeather.Temperature" unit="@temperatureUnit"></temperature>
            <span>°@temperatureUnit</span>
        </div>
        <div class="flex-grow-1"></div>
        <div class="d-flex gap-4 head-link-menu" id="navLinks" data-active-tab="@ViewData["ActiveTab"]">
            <a asp-action="Day" asp-route-day="-1" id="yesterday">Yesterday</a>
            <a asp-action="Now" id="now">Now</a>
            <a asp-action="Hourly" id="hourly">Hourly</a>
            <a asp-action="Day" asp-route-day="0" id="today">Today</a>
            <a asp-action="Day" asp-route-day="1" id="tomorrow">Tomorrow</a>
            <a asp-action="ThreeDays" id="threeDays">3 days</a>
            <a asp-action="SevenDays" id="sevenDays">7 days</a>
            <a asp-action="TwoWeeks" id="twoWeeks">2 weeks</a>
        </div>
    </div>
</div>

<script src="/js/highlight-active-weather-link.js" asp-append-version="true"></script>