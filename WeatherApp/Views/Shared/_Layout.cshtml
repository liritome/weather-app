@using WeatherApp.Models;

<!DOCTYPE html>

<html class="h-100">
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>Cloudnest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100" style="background-color:#ededed">
    <header class="container-fluid p-0" style="width: 1016px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-2">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ps-0">
                    <a asp-action="Now">
                        <img src="/svg/logo.svg" width="180" />
                    </a>
                </div>
                <div>
                    <input id="locationSearch" class="form-control border-0" style="background-color:#ededed" type="text" placeholder="Search location" autocomplete="off" />
                    <ul id="searchResults" class="list-group position-absolute" style="z-index: 10;"></ul>
                </div>
                <div>
                    @{
                        var location = ViewData["Location"] as Location;
                    }
                    <div id="locationLinks" class="d-flex gap-3 head-location-menu" data-active-city-id="@location?.Id">
                        <a asp-route-city="Krasilovka-704489" id="704489">Krasilovka</a>
                        <a asp-route-city="New_York-5128581" id="5128581">New York</a>
                        <a asp-route-city="Canberra-2172517" id="2172517">Canberra</a>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <div class="dropdown">
                    <button class="btn dropdown-toggle" type="button" id="dropdownMetrics" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        °C, m/s
                    </button>
                    <div class="dropdown-menu py-1" aria-labelledby="dropdownMetrics">
                        <button class="dropdown-item" type="button">°C, m/s</button>
                        <button class="dropdown-item" type="button">°F, mph</button>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn dropdown-toggle" type="button" id="dropdownLang" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        EN
                    </button>
                    <div class="dropdown-menu py-1" aria-labelledby="dropdownLang">
                        <button class="dropdown-item" type="button">UA</button>
                        <button class="dropdown-item" type="button">EN</button>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_Menu" model="Model" />
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="container-fluid mt-4 mb-2 p-0" style="width: 944px;">
        <div class="py-2 text-muted text-center border-top border-2" style="font-size: 12px; color: gray">
            The data is intended for private, non-commercial use only. ©Cloudnest 2025
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/highlight-active-location.js" asp-append-version="true"></script>
    <script src="/js/page-reload.js" asp-append-version="true"></script>
    <script src="/js/fill-search-result.js" asp-append-version="true"></script>
    @RenderSection("Scripts", false)
</body>
</html>