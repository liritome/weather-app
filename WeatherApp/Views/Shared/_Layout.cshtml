<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-dark bg-opacity-10">
    <header class="container-fluid" style="width: 944px;">
        <div class="row rounded-3 my-2" style="height: 130px;">
            <div class="col p-2 pt-1 d-flex flex-column text-white bg-primary rounded-3 bg-opacity-75">
                <div style="font-size: 16px" class="head-link-menu">
                    <a href="#">Ukraine</a> / <a href="#">Kyiv oblast</a> / <a href="#">Brovary raion</a>
                </div>
                <div class="fw-bold" style="font-size: 24px">
                    Cloudy in Krasylivka, +11 °C
                </div>
                <div class="flex-grow-1"></div>
                <!-- MOVE STYLE -->
                <style>
                    .head-link-menu{
                        a{
                            text-decoration: none;
                            color: white;
                        }
                        a:hover{
                            opacity: 0.5;
                        }

                        .link-active:hover {
                            opacity: 1;
                        }
                    }                    
                </style>
                <!---->
                <div class="d-flex gap-4 head-link-menu">
                    <a href="#" class="link-active">Now</a>
                    <a href="#">Today</a>
                    <a href="#">Tomorrow</a>
                    <a href="#">3 days</a>
                    <a href="#">7 days</a>
                    <a href="#">2 weeks</a>
                    <a href="#">Month</a>
                </div>
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
