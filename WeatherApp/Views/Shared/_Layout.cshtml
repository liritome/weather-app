@using WeatherApp.Models;
@using WeatherApp.Helpers;

@{
    var location = ViewData["Location"] as Location;
    var locationWithId = $"{location.Name}-{location.Id}";

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
    string speedUnit = Context.Request.Cookies["speedUnit"] ?? WeatherHelper.DefaultSpeedUnit;
}

<!DOCTYPE html>

<html class="h-100">
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>Cloudnest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100 main-body">
    <div id="overlay"></div>
    <header class="container-fluid p-0 main-width">
        <div class="d-flex justify-content-between align-items-center bg-white p-2">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ps-0">
                    <a asp-action="Now" asp-route-city="@locationWithId">
                        <img src="/svg/logo.svg" width="180" />
                    </a>
                </div>
                <div id="searchContainer">
                    <div class="position-relative search-box">
                        <i class="bi bi-search position-absolute search-icon"></i>
                        <input id="search" class="form-control border-0 search-input" type="text" placeholder="Search location" autocomplete="off" />
                    </div>
                    <ul id="searchResults" class="list-group position-absolute pt-2"></ul>
                </div>
                <div class="location-links-box">
                    <div id="locationLinks" class="d-inline-flex gap-2 head-location-menu" data-active-city-id="@location?.Id">
                    </div>
                </div>
            </div>
            <div>
                <button class="btn" id="settingsBtn">
                    <span>°@temperatureUnit,</span>
                    <span>@speedUnit</span>
                </button>
                <div id="settings" class="p-3 rounded bg-white position-absolute">
                    <div class="text-center position-relative settings-header">
                        <span>Settings</span>
                        <button id="settingsCloseBtn" class="p-0 btn position-absolute close-btn">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div>
                        <div class="my-2">
                            <span>Units</span>
                        </div>
                        <div class="d-flex justify-content-between gap-2">
                            <div class="dropdown">
                                <select id="temperatureUnitSwitcher" class="form-select">
                                    <option value="C">°C</option>
                                    <option value="F">°F</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="speedUnitSwitcher" class="form-select">
                                    <option value="m/s">m/s</option>
                                    <option value="km/h">km/h</option>
                                    <option value="mph">mph</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="precipUnitSwitcher" class="form-select">
                                    <option value="mm">mm</option>
                                    <option value="in">in</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="pressureUnitSwitcher" class="form-select">
                                    <option value="mmHg">mmHg</option>
                                    <option value="hPa">hPa</option>
                                    <option value="inHg">inHg</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_Menu" model="Model" />
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="container-fluid mt-4 mb-2 p-0 main-width">
        <div class="py-2 text-muted text-center border-top border-2 footer-text-box">
            The data is intended for private, non-commercial use only. ©Cloudnest 2025
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/page-reload.js" asp-append-version="true"></script>
    <script src="/js/fill-search-result.js" asp-append-version="true"></script>
    <script src="/js/save-location-from-url.js" asp-append-version="true"></script>
    <script src="/js/change-units.js" asp-append-version="true"></script>
    <script src="/js/open-search.js" asp-append-version="true"></script>
    <script src="/js/open-settings.js" asp-append-version="true"></script>
    @RenderSection("Scripts", false)
</body>
</html>