@using WeatherApp.Models;
@using WeatherApp.Helpers;

@{
    var location = ViewData["Location"] as Location;
    string locationIdString = $"{location?.Name}-{location?.Id}";

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
}

<!DOCTYPE html>

<html class="h-100">
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>Cloudnest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100" style="background-color:#ededed">
    <div id="overlay"></div>
    <header class="container-fluid p-0" style="width: 1016px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-2">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ps-0">
                    <a asp-action="Now" asp-route-city="@locationIdString">
                        <img src="/svg/logo.svg" width="180" />
                    </a>
                </div>
                <div id="searchContainer">
                    <div class="position-relative" style="width: 200px;">
                        <i class="bi bi-search position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); color: gray;"></i>
                        <input id="search" class="form-control border-0" style="background-color:#ededed; transition: width 0.3s ease; padding-inline-start: 35px;" type="text" placeholder="Search location" autocomplete="off" />
                    </div>
                    <ul id="searchResults" class="list-group position-absolute pt-2" style="box-shadow: 0 0 1rem rgba(0, 0, 0, 0.3);"></ul>
                </div>
                <div style="width: 450px;">
                    <div id="locationLinks" class="d-inline-flex gap-2 head-location-menu" style="box-shadow: inset 0 -1px 0 0 lightgrey;" data-active-city-id="@location?.Id">
                    </div>
                </div>
            </div>
            <div>
                <button class="btn" id="settingsBtn">
                    <span>°@temperatureUnit,</span>
                    <span>EN</span>
                </button>
                <div id="settings" class="p-3 rounded bg-white position-absolute" style="width: 400px; display: none; transform: translate(-85%); box-shadow: 0 0 1rem rgba(0, 0, 0, 0.3); z-index: 10">
                    <div class="text-center position-relative" style="font-size: 20px; font-weight: 500;">
                        <span>Settings</span>
                        <button id="settingsCloseBtn" class="p-0 btn position-absolute" style="top: 0; right: 0;">
                            <i class="bi bi-x-lg" style="font-size: 20px;"></i>
                        </button>
                    </div>
                    <div>
                        <div class="my-2">
                            <span>Units</span>
                        </div>
                        <div class="d-flex justify-content-between gap-2">
                            <div class="dropdown">
                                <select id="temperatureUnitSwitcher" class="form-select" style="width: auto;">
                                    <option value="C">°C</option>
                                    <option value="F">°F</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="speedUnitSwitcher" class="form-select" style="width: auto;">
                                    <option value="m/s">m/s</option>
                                    <option value="km/h">km/h</option>
                                    <option value="mph">mph</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="precipUnitSwitcher" class="form-select" style="width: auto;">
                                    <option value="mm">mm</option>
                                    <option value="in">in</option>
                                </select>
                            </div>
                            <div class="dropdown">
                                <select id="pressureUnitSwitcher" class="form-select" style="width: auto;">
                                    <option value="mmHg">mmHg</option>
                                    <option value="hPa">hPa</option>
                                    <option value="inHg">inHg</option>
                                </select>
                            </div>
                        </div>
                        <div class="my-2">
                            <span>Language</span>
                        </div>
                        <div class="dropdown">
                            <select id="languageSwitcher" class="form-select" style="width: auto;">
                                <option value="EN">English</option>
                                <option value="UA">Ukrainian</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_Menu" model="Model" />
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="container-fluid mt-4 mb-2 p-0" style="width: 944px;">
        <div class="py-2 text-muted text-center border-top border-2" style="font-size: 12px; color: gray">
            The data is intended for private, non-commercial use only. ©Cloudnest 2025
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/page-reload.js" asp-append-version="true"></script>
    <script src="/js/fill-search-result.js" asp-append-version="true"></script>
    <script src="/js/change-units.js" asp-append-version="true"></script>
    <script src="/js/open-search.js" asp-append-version="true"></script>
    <script src="/js/open-settings.js" asp-append-version="true"></script>
    @RenderSection("Scripts", false)
</body>
</html>