<!DOCTYPE html>

<html class="h-100">
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100" style="background-color:#ededed">
    <header class="container-fluid" style="width: 944px;">
        <div class="row d-flex align-items-center bg-white p-2">
            <div class="col-2 ps-0" style="font-size: 24px; color: #4e99e4">
                Weather App
            </div>
            <div class="col-3">
                <input class="form-control border-0" style="background-color:#ededed" type="text" placeholder="Search location" autocomplete="off" />
            </div>
            <div class="col">
                <!-- MOVE STYLE -->
                <style>
                    .head-location-menu a {
                        text-decoration: none;
                        color: black;
                        opacity: 0.6;
                    }

                    .head-location-menu a:hover {
                        color: black;
                        opacity: 1;
                    }
                    .head-location-menu .location-active {
                        opacity: 1;
                        color: black;
                    }

                    .head-location-menu a.location-active:hover {
                        color: black;
                    }
                </style>
                <!---->
                <div class="d-flex gap-3 head-location-menu">
                    <a class="location-active">Krasylivka</a>
                    <a href="#">Brovary</a>
                    <a href="#">Kyiv</a>
                    <a href="#">New-York</a>
                </div>
            </div>
            <!--REMOVE STYLE-->
            <style>
                .dropdown-menu{
                    --bs-dropdown-min-width: 60px;
                }
                .dropdown-menu .dropdown-item:active,
                .dropdown-menu .dropdown-item.active,
                .dropdown-menu .dropdown-item:focus {
                    background-color: #ededed;
                    color: black;
                }
            </style>
            <!---->
            <div class="col-2 d-flex justify-content-end">
                <div class="dropdown me-1">
                    <button class="btn dropdown-toggle" type="button" id="dropdownMetrics" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        °C, m/s
                    </button>
                    <div class="dropdown-menu py-1" aria-labelledby="dropdownMetrics">
                        <button class="dropdown-item" type="button">°C, m/s</button>
                        <button class="dropdown-item" type="button">°F, mph</button>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn dropdown-toggle" type="button" id="dropdownLang" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        EN
                    </button>
                    <div class="dropdown-menu py-1" aria-labelledby="dropdownLang">
                        <button class="dropdown-item" type="button">UA</button>
                        <button class="dropdown-item" type="button">EN</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-2" style="height: 130px;">
            <div class="col p-2 pt-1 d-flex flex-column text-white rounded-bottom-3" style="background-color:#4e99e4">
                <div style="font-size: 16px" class="head-link-menu">
                    <a href="#">Ukraine</a> / <a href="#">Kyiv oblast</a> / <a href="#">Brovary raion</a>
                </div>
                <div class="fw-bold" style="font-size: 24px">
                    Cloudy in Krasylivka, +12 °C
                </div>
                <div class="flex-grow-1"></div>
                <!-- MOVE STYLE -->
                <style>
                    .head-link-menu a {
                        text-decoration: none;
                        color: white;
                        opacity: 1;
                    }

                    .head-link-menu a:hover {
                        opacity: 0.6;
                    }

                    .head-link-menu .link-active{
                        opacity: 1;
                    }

                    .head-link-menu .link-active:hover {
                        opacity: 1;
                    }
                </style>
                <!---->
                <div class="d-flex gap-4 head-link-menu">
                    <a class="link-active">Now</a>
                    <a href="#">Today</a>
                    <a href="#">Tomorrow</a>
                    <a href="#">3 days</a>
                    <a href="#">7 days</a>
                    <a href="#">2 weeks</a>
                    <a href="#">Month</a>
                </div>
            </div>
        </div>
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="container-fluid mt-4 mb-2" style="width: 944px;">
        <div class="py-2 text-muted text-center border-top border-2" style="font-size: 12px; color: gray">
            The data is intended for private, non-commercial use only. ©WeatherApp 2025
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
