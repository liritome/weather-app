@using WeatherApp.Helpers

@model WeatherApp.Models.OpenMeteoData

@{
    Dictionary<string, string> tabs = new()
        {
            {"Yesterday", "yesterday"},
            {"Today", "today"},
            {"Tomorrow", "tomorrow"},
            {"in 2 days", "2day"},
        };
}

<div class="container-fluid p-0" style="width: 944px;">
    <div class="my-2" style="font-size: 24px">
        <div class="col p-0">
            Weather now
        </div>
    </div>
    <div class="d-flex my-2 gap-2">
        @for (int i = -1; i <= 2; i++)
        {
            <a href="@tabs.ElementAt(i + 1).Value" class="text-decoration-none text-black">
                <div class="p-2 pt-1 rounded bg-white hover-shadow" style="width: 230px; height: 110px;">
                    <div class="d-flex flex-row h-100">
                        <div class="d-flex flex-column w-75">
                            <div style="height: 24px; font-size: 20px">@DateTime.Today.AddDays(i).ToString("ddd, dd MMM")</div>
                            <div class="text-secondary" style="height: 20px;">@tabs.ElementAt(i + 1).Key</div>
                            <div class="flex-grow-1"></div>
                            <div class="d-flex mt-2" style="font-size: 24px">
                                <div class="text-center w-50 bg-success bg-opacity-50">@((Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).TemperatureMin > 0 ? "+" : "") + Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).TemperatureMin)</div>
                                <div class="text-center w-50 bg-success bg-opacity-75">@((Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).TemperatureMax > 0 ? "+" : "") + Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).TemperatureMax)</div>
                            </div>
                        </div>
                        <div class="d-flex flex-column text-center w-15">
                            <div>@Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).WeatherDescription</div>
                            <div class="flex-grow-1"></div>
                            <div class="text-primary">@Model.DailyWeatherData.GetDailyWeatherByDate(DateTime.Today.AddDays(i)).PrecipitationSum mm</div>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
    <partial name="Current" model="Model" />
</div>