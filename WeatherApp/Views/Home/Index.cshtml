@using WeatherApp.Helpers
@model WeatherApp.Models.OpenMeteoResponse
@{
    DateTime CurrentDate = DateTime.Now;
    DateTime Sunrise = Model.DailyWeather.Sunrise.First();
    DateTime Sunset = Model.DailyWeather.Sunset.First();
}

<div class="container-fluid" style="width: 944px;">
    <div class="row my-2" style="font-size: 24px">
        <div class="col p-0">
            Weather now
        </div>
    </div>
    <div class="row my-2 gap-2">
        <div class="col p-2 pt-1 rounded bg-white" style="width: 230px; height: 110px;">
            <div class="row" style="height: 100%;">
                <div class="col-8 d-flex flex-column">
                    <div style="height: 24px; font-size: 20px">Now</div>
                    <div class="text-secondary" style="height: 20px;">@DateTime.Now.ToString("HH:mm")</div>
                    <div class="flex-grow-1"></div>
                    <div class="d-flex mt-2" style="font-size: 24px">
                        <div class="text-center w-50 bg-success bg-opacity-50">+5</div>
                        <div class="text-center w-50 bg-success bg-opacity-75">+10</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div>Cloudy</div>
                    <div>No rain</div>
                    <div class="text-primary">0 mm</div>
                </div>
            </div>
        </div>
        <div class="col p-2 pt-1 rounded bg-white" style="width: 230px; height: 110px;">
            <div class="row" style="height: 100%;">
                <div class="col-8 d-flex flex-column">
                    <div style="height: 24px; font-size: 20px">@DateTime.Today.ToString("ddd, dd MMM")</div>
                    <div class="text-secondary" style="height: 20px;">Today</div>
                    <div class="flex-grow-1"></div>
                    <div class="d-flex mt-2" style="font-size: 24px">
                        <div class="text-center w-50 bg-success bg-opacity-50">+5</div>
                        <div class="text-center w-50 bg-success bg-opacity-75">+12</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div>Partly cloudy</div>
                    <div>No rain</div>
                    <div class="text-primary">0 mm</div>
                </div>
            </div>
        </div>
        <div class="col p-2 pt-1 rounded bg-white" style="width: 230px; height: 110px;">
            <div class="row" style="height: 100%;">
                <div class="col-8 d-flex flex-column">
                    <div style="height: 24px; font-size: 20px">@DateTime.Today.AddDays(1).ToString("ddd, dd MMM")</div>
                    <div class="text-secondary" style="height: 20px;">Tomorrow</div>
                    <div class="flex-grow-1"></div>
                    <div class="d-flex mt-2" style="font-size: 24px">
                        <div class="text-center w-50 bg-success bg-opacity-50">+6</div>
                        <div class="text-center w-50 bg-success bg-opacity-75">+14</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div>Cloudy</div>
                    <div>Light rain</div>
                    <div class="text-primary">0.6 mm</div>
                </div>
            </div>
        </div>
        <div class="col p-2 pt-1 rounded bg-white" style="width: 230px; height: 110px;">
            <div class="row" style="height: 100%;">
                <div class="col-8 d-flex flex-column">
                    <div style="height: 24px; font-size: 20px">@DateTime.Today.AddDays(2).ToString("ddd, dd MMM")</div>
                    <div class="text-secondary" style="height: 20px;">in 2 days</div>
                    <div class="flex-grow-1"></div>
                    <div class="d-flex mt-2" style="font-size: 24px">
                        <div class="text-center w-50 bg-success bg-opacity-50">+8</div>
                        <div class="text-center w-50 bg-success bg-opacity-75">+17</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div>Sun</div>
                    <div>No rain</div>
                    <div class="text-primary">0 mm</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row p-2 rounded bg-white my-2">
        <div class="col d-flex flex-column text-white text-center" style="background-color:#4e99e4">
            <div class="my-3" style="font-size: 20px">
                @CurrentDate.ToString("ddd, dd MMMM, HH:mm")
            </div>
            <div class="position-relative">
                <div class="position-absolute top-50 start-50" style="transform: translate(-50%, 33%)">
                    <h1 style="font-size: 96px;">@(Model.CurrentWeather.Temperature > 0 ? "+" + Model.CurrentWeather.Temperature : Model.CurrentWeather.Temperature)</h1>
                    <h4 style="font-size: 16px;">Feels like @(Model.CurrentWeather.ApparentTemperature > 0 ? "+" + Model.CurrentWeather.ApparentTemperature : Model.CurrentWeather.ApparentTemperature)</h4>
                    <h2 style="font-size: 30px;">@WeatherDescriptor.GetWeatherDescription(Model.CurrentWeather.Code)</h2>
                </div>
            </div>
            <div class="d-flex justify-content-center gap-2 mb-3">
                <div class="d-flex flex-column justify-content-center">
                    <div>@Sunrise.ToString("HH:mm")</div>
                    <div>Sunrise</div>
                </div>
                <div>
                    <div style="background-image: url('/svg/sun.svg'); background-size: 350px 350px; transform: rotate(70deg); width: 350px; height: 350px;"></div>
                </div>
                <div class="d-flex flex-column justify-content-center">
                    <div>@Sunset.ToString("HH:mm")</div>
                    <div>Sunset</div>
                </div>
            </div>
            <div class="row py-3" style="background-color:rgba(0, 0, 0, 0.10);">
                <div class="col">
                    <div>Wind</div>
                    <div>
                        <strong>@Model.CurrentWeather.WindSpeed</strong>
                        <small>m/s @Model.CurrentWeather.WindDirection</small>
                    </div>
                </div>
                <div class="col">
                    <div>Pressure</div>
                    <div>
                        <strong>@Model.CurrentWeather.Pressure</strong>
                        <small>mm Hg</small>
                    </div>
                </div>
                <div class="col">
                    <div>Humidity</div>
                    <div>
                        <strong>@Model.CurrentWeather.Humidity</strong>
                        <small>%</small>
                    </div>
                </div>
                <div class="col">
                    <div>Precipitation</div>
                    <div>
                        <strong>@Model.CurrentWeather.Presipitation</strong>
                        <small>mm</small>
                    </div>
                </div>
                <div class="col">
                    <div>Clouds</div>
                    <div>
                        <strong>@Model.CurrentWeather.CloudCover</strong>
                        <small>%</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>