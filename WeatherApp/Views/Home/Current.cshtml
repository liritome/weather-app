@using WeatherApp.Helpers
@model WeatherApp.Models.OpenMeteoResponse
@{
    DateTime now = DateTime.Now;
    DateTime sunrise = Model.DailyWeather.Sunrise.First();
    DateTime sunset = Model.DailyWeather.Sunset.First();
    double sunAngle = WeatherDescriptor.GetSunAngle(now, sunrise, sunset);
}

<div class="p-2 rounded bg-white my-2">
    <div class="d-flex flex-column text-white text-center" style="background-color:#4e99e4">
        <div class="my-3" style="font-size: 20px">
            @now.ToString("ddd, dd MMMM, HH:mm")
        </div>
        <div class="position-relative">
            <div class="position-absolute top-50 start-50" style="transform: translate(-50%, 35%)">
                <h1 style="font-size: 96px;">@((Model.CurrentWeather.Temperature > 0 ? "+" : "") + Model.CurrentWeather.Temperature)</h1>
                <h4 style="font-size: 16px;">Feels like @((Model.CurrentWeather.ApparentTemperature > 0 ? "+" : "") + Model.CurrentWeather.ApparentTemperature)</h4>
                <h2 style="font-size: 30px;">@WeatherDescriptor.GetWeatherDescription(Model.CurrentWeather.Code)</h2>
            </div>
        </div>
        <div class="d-flex justify-content-center gap-2 mb-3">
            <div class="d-flex flex-column justify-content-center">
                <div>@sunrise.ToString("HH:mm")</div>
                <div>Sunrise</div>
            </div>
            <div>
                <div style="background-image: url('/svg/sun.svg'); background-size: 350px 350px; transform: rotate(@(sunAngle)deg); width: 350px; height: 350px;"></div>
            </div>
            <div class="d-flex flex-column justify-content-center">
                <div>@sunset.ToString("HH:mm")</div>
                <div>Sunset</div>
            </div>
        </div>
        <div class="py-3 d-flex justify-content-around" style="background-color:rgba(0, 0, 0, 0.10);">
            <div>
                <div>Wind</div>
                <div>
                    <strong>@Model.CurrentWeather.WindSpeed</strong>
                    <small>m/s @Model.CurrentWeather.WindDirection</small>
                </div>
            </div>
            <div>
                <div>Pressure</div>
                <div>
                    <strong>@Model.CurrentWeather.Pressure</strong>
                    <small>mm Hg</small>
                </div>
            </div>
            <div>
                <div>Humidity</div>
                <div>
                    <strong>@Model.CurrentWeather.Humidity</strong>
                    <small>%</small>
                </div>
            </div>
            <div>
                <div>Precipitation</div>
                <div>
                    <strong>@Model.CurrentWeather.Presipitation</strong>
                    <small>mm</small>
                </div>
            </div>
            <div>
                <div>Clouds</div>
                <div>
                    <strong>@Model.CurrentWeather.CloudCover</strong>
                    <small>%</small>
                </div>
            </div>
        </div>
    </div>
</div>