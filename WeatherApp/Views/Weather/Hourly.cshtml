@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoWeatherData

@{
    var openMeteoData = Model;

    DateTime localNow = DateTime.UtcNow.AddSeconds(Model.UtcOffsetSeconds);

    int hoursLeftToday = (int)Math.Ceiling((localNow.Date.AddDays(1) - localNow).TotalHours);
    int daysAfterToday = 1;
    int days = daysAfterToday + 1;
    int hours = hoursLeftToday + daysAfterToday * 24;
    int hoursVisible = 16;
    HourlyWeather hourlyWeather = openMeteoData.HourlyWeatherData.GetHourlyWeatherByDate(localNow, hours);

    int hourStep = 1;
    double parentWidth = 1000;
    double itemWidth = parentWidth / hoursVisible;
    double todayWidth = itemWidth * hoursLeftToday;
    double tomorrowWidth = itemWidth * 24;

    List<(int, byte)> iconData = hourlyWeather.Code.Zip(hourlyWeather.IsDay, (c, d) => (c, d)).ToList();

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
    string speedUnit = Context.Request.Cookies["speedUnit"] ?? WeatherHelper.DefaultSpeedUnit;
    string precipUnit = Context.Request.Cookies["precipUnit"] ?? WeatherHelper.DefaultPrecipUnit;
    string pressureUnit = Context.Request.Cookies["pressureUnit"] ?? WeatherHelper.DefaultPressureUnit;
}

<div class="container-fluid p-0" style="width: 1016px;">
    <div class="mt-2 mb-3" style="font-size: 24px">
        <div class="d-flex gap-3">
            <span class="me-auto">Hourly weather</span>
            <partial name="_DataSet" />
            <div class="d-flex gap-2">
                <button id="btnLeft" type="button" class="btn btn-light rounded px-2 py-0 shadow-sm d-flex justify-content-center align-items-center">
                    <img src="/svg/arrow-left.svg" width="32" height="16" />
                </button>
                <button id="btnRight" type="button" class="btn btn-light rounded px-2 py-0 shadow-sm d-flex justify-content-center align-items-center">
                    <img src="/svg/arrow-right.svg" width="32" height="16" />
                </button>
            </div>
        </div>
    </div>
    <div class="p-2 rounded bg-white mb-2">
        <div id="grid-container" data-items="@hours" data-item-width="@itemWidth" data-items-visible="@hoursVisible" data-step="3" class="position-relative overflow-hidden">
            <div class="slider d-grid" style="grid-template-columns: @(todayWidth + "px") @(tomorrowWidth + "px"); transition: transform 0.25s ease-in-out;">
                @{
                    string displayTodayDate = localNow.Hour > 22 ? "display: none;" : "";
                    string displayToday = localNow.Hour > 21 ? "display: none;" : "";
                }
                <div class="ps-2 d-flex" style="font-size: 18px; white-space: nowrap; overflow: hidden;">
                    <date date="@localNow" format="dayWeekdayMonthLong" style="@displayTodayDate"></date>
                    <span class="ps-2" style="color: black; opacity: 0.5; @displayToday">today</span>
                </div>
                <div class="ps-2 d-flex" style="font-size: 18px; white-space: nowrap; overflow: hidden;">
                    <date date="@localNow.AddDays(1)" format="dayWeekdayMonthLong"></date>
                    <span class="ps-2" style="color: black; opacity: 0.5;">tomorrow</span>
                </div>
            </div>
            <div class="slider pt-2" style="transition: transform 0.25s ease-in-out;">
                <time-grid data="hourlyWeather.Time" step="hourStep" item-width="itemWidth" local-now="localNow"></time-grid>
            </div>
            <div class="slider pt-2" style="transition: transform 0.25s ease-in-out;">
                <icon-grid data="iconData" step="hourStep" item-width="itemWidth" width="50"></icon-grid>
            </div>
            <div id="temperatureContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Air temperature, °@temperatureUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <temperature-grid data="hourlyWeather.Temperature" step="hourStep" item-width="itemWidth" unit="@temperatureUnit"></temperature-grid>
                </div>
            </div>
            <div id="apparentTemperatureContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Feels like, °@temperatureUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <temperature-grid data="hourlyWeather.ApparentTemperature" step="hourStep" item-width="itemWidth" unit="@temperatureUnit"></temperature-grid>
                </div>
            </div>
            <div id="windDirectionContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Wind direction</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <wind-direction-grid data="hourlyWeather.WindDirectionDegree" step="hourStep" item-width="itemWidth"></wind-direction-grid>
                </div>
            </div>
            <div id="windSpeedContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Wind speed, @speedUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <wind-grid data="hourlyWeather.WindSpeed" step="hourStep" item-width="itemWidth" unit="@speedUnit"></wind-grid>
                </div>
            </div>
            <div id="windGustsContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Wind gusts, @speedUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <wind-grid data="hourlyWeather.WindGusts" step="hourStep" item-width="itemWidth" unit="@speedUnit"></wind-grid>
                </div>
            </div>
            <div id="precipitationProbabilityContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Precipitation probability, %</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <precip-probab-grid data="hourlyWeather.PrecipitationProbability" step="hourStep" item-width="itemWidth"></precip-probab-grid>
                </div>
            </div>
            <div id="precipitationContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Precipitation, @precipUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <precipitation-grid data="hourlyWeather.Precipitation" step="hourStep" item-width="itemWidth" unit="@precipUnit"></precipitation-grid>
                </div>
            </div>
            <div id="pressureContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Pressure, @pressureUnit</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <pressure-grid data="hourlyWeather.Pressure" step="hourStep" item-width="itemWidth" unit="@pressureUnit"></pressure-grid>
                </div>
            </div>
            <div id="humidityContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Humidity, %</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <humidity-grid data="hourlyWeather.Humidity" step="hourStep" item-width="itemWidth"></humidity-grid>
                </div>    
            </div>
            <div id="uvIndexContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">UV index</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <uv-index-grid data="hourlyWeather.UvIndex" step="hourStep" item-width="itemWidth"></uv-index-grid>
                </div>
            </div>
            <div id="cloudCoverContainer" class="pt-2" style="display: none">
                <p class="px-2 my-1">Cloud cover, %</p>
                <div class="slider" style="transition: transform 0.25s ease-in-out;">
                    <cloud-cover-grid data="hourlyWeather.CloudCover" step="hourStep" item-width="itemWidth"></cloud-cover-grid>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/slider-controller.js" asp-append-version="true"></script>