@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoData

@{
    var openMeteoData = Model;

    DateTime localNow = DateTime.UtcNow.AddSeconds(openMeteoData.UtcOffsetSeconds);
    int daysInMonth = DateTime.DaysInMonth(localNow.Year, localNow.Month);
    // to start a week from monday
    int dayOfWeek = ((int)localNow.DayOfWeek + 6) % 7; 
    int days = 14;
    DailyWeather dailyWeather = openMeteoData.DailyWeatherData.GetDailyWeather(localNow, days);
}

<div class="container-fluid p-0" style="width: 1016px;">
    <div class="mt-2 mb-3" style="font-size: 24px">
        <div class="p-0 d-flex justify-content-between">
            <span>Weather for 2 weeks</span>
        </div>
    </div>
    <div class="p-2 rounded bg-white mb-2">
        <div class="position-relative">
            <div class="d-grid" style="grid-template-columns: repeat(7, 1fr); font-size: 18px;">
                <span>Mon</span>
                <span>Tue</span>
                <span>Wed</span>
                <span>Thu</span>
                <span>Fri</span>
                <span>Sat</span>
                <span>Sun</span>
            </div>
        </div>
        <div class="position-relative">
            <div class="d-grid" style="grid-template-columns: repeat(7, 1fr);">
                @for (int i = 0; i < dayOfWeek; i++)
                {
                    <div></div>
                }
                @for (int day = 0; day < days; day++)
                {
                    var date = localNow.AddDays(day);
                    var dayWeather = dailyWeather.Time[day];
                    <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="@day"
                       class="text-decoration-none text-black border text-center p-2">
                        <div>
                            <date date="@date" format="day"></date>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>