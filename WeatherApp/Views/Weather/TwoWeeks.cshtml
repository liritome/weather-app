@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoWeatherData

@{
    var openMeteoData = Model;

    DateTime localNow = DateTime.UtcNow.AddSeconds(openMeteoData.UtcOffsetSeconds);
    int days = WeatherHelper.Days;
    DailyWeather dailyWeather = openMeteoData.DailyWeatherData.GetDailyWeather(localNow, days);
    int firstDayDayOfWeek = ((int)localNow.DayOfWeek + 6) % 7;
    int pastDays = firstDayDayOfWeek;
    int totalCells = pastDays + days;
    int trailingEmptyCells = (7 - (totalCells % 7)) % 7;

    double averageTemp = (dailyWeather.TemperatureMax.Average() + dailyWeather.TemperatureMin.Average()) / 2;
    string color = WeatherHelper.GetTemperatureColor(averageTemp);

    var location = ViewData["Location"] as Location;
    var locationWithId = $"{location.Name}-{location.Id}";

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
    string speedUnit = Context.Request.Cookies["speedUnit"] ?? WeatherHelper.DefaultSpeedUnit;
    string precipUnit = Context.Request.Cookies["precipUnit"] ?? WeatherHelper.DefaultPrecipUnit;
    string pressureUnit = Context.Request.Cookies["pressureUnit"] ?? WeatherHelper.DefaultPressureUnit;
}

<div class="container-fluid p-0 main-width">
    <div class="mt-2 mb-3 font-24">
        <div>
            <span>Weather for 2 weeks</span>
        </div>
    </div>
    <div class="p-2 rounded bg-white mb-2">
        <div class="d-flex gap-2">
            <div class="flex-grow-1 rounded-3 p-2 month-left">
                <div class="mb-2 text-center font-20">
                    <span>@localNow.ToString("MMMM")</span>
                    @if (localNow.AddDays(days).Month != localNow.Month)
                    {
                        <span> - @localNow.AddDays(days).ToString("MMMM")</span>
                    }
                </div>
                <div class="d-flex flex-column gap-3">
                    @{
                        double maxTemp = dailyWeather.TemperatureMax.Max();
                        int maxTempIndex = dailyWeather.TemperatureMax.IndexOf(maxTemp);
                        DateTime hottestDay = dailyWeather.Time[maxTempIndex];
                        string maxTempColor = WeatherHelper.GetTemperatureColor(maxTemp);
                    }
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="font-16">Highest temperature</span>
                        <div class="d-flex gap-1 align-items-end lh-1 p-2 rounded-pill pill-box" style="background-color: @maxTempColor;">
                            <div class="flex-grow-1 month-statistics-value">
                                <temperature value="@maxTemp" unit="@temperatureUnit"></temperature>
                            </div>
                            <div class="font-14">@hottestDay.ToString("MMM dd")</div>
                        </div>
                    </div>
                    @{
                        double minTemp = dailyWeather.TemperatureMin.Min();
                        int minTempIndex = dailyWeather.TemperatureMin.IndexOf(minTemp);
                        DateTime coldestDay = dailyWeather.Time[minTempIndex];
                        string minTempColor = WeatherHelper.GetTemperatureColor(minTemp);
                    }
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="font-16">Lowest temperature</span>
                        <div class="d-flex gap-1 align-items-end lh-1 p-2 rounded-pill pill-box" style="background-color: @minTempColor;">
                            <div class="flex-grow-1 month-statistics-value">
                                <temperature value="@minTemp" unit="@temperatureUnit"></temperature>
                            </div>
                            <div class="font-14">@coldestDay.ToString("MMM dd")</div>
                        </div>
                    </div>
                    @{
                        var tempSwing = dailyWeather.TemperatureMin.Zip(dailyWeather.TemperatureMax, (min, max) => Math.Abs(max - min)).ToList();
                        double maxTempSwing = tempSwing.Max();
                        int maxTempSwingIndex = tempSwing.IndexOf(maxTempSwing);
                        DateTime maxTempSwingDay = dailyWeather.Time[maxTempSwingIndex];
                        double swingMin = dailyWeather.TemperatureMin[maxTempSwingIndex];
                        double swingMax = dailyWeather.TemperatureMax[maxTempSwingIndex];
                        string swingMinColor = WeatherHelper.GetTemperatureColor(swingMin);
                        string swingMaxColor = WeatherHelper.GetTemperatureColor(swingMax);
                    }
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="font-16">Largest temp. swing</span>
                        <div class="d-flex gap-1 align-items-end lh-1 p-2 rounded-pill pill-box" style="background-image: linear-gradient(to right, @swingMinColor, @swingMaxColor);">
                            <div class="flex-grow-1 month-statistics-value">
                                <span>
                                    <temperature value="@swingMin" unit="@temperatureUnit"></temperature> - <temperature value="@swingMax" unit="@temperatureUnit"></temperature>
                                </span>
                            </div>
                            <div class="font-14">@maxTempSwingDay.ToString("MMM dd")</div>
                        </div>
                    </div>
                    @{
                        double maxWind = dailyWeather.WindGustsMax.Max();
                        int maxWindIndex = dailyWeather.WindGustsMax.IndexOf(maxWind);
                        DateTime maxWindDay = dailyWeather.Time[maxWindIndex];
                        string maxWindColor = WeatherHelper.GetWindColor(maxWind);
                    }
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="font-16">Highest wind speed</span>
                        <div class="d-flex gap-1 align-items-end lh-1 p-2 rounded-pill pill-box" style="background-color: @maxWindColor;">
                            <div class="flex-grow-1 month-statistics-value">
                                <wind-speed value="@maxWind" unit="@speedUnit"></wind-speed>
                            </div>
                            <div class="font-14">@maxWindDay.ToString("MMM dd")</div>
                        </div>
                    </div>
                    @{
                        double precipSum = Math.Round(dailyWeather.PrecipitationSum.Sum(), 1);
                        string waterColor = "#83c7ff";
                    }
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="font-16">Precipitation sum</span>
                        <div class="d-flex gap-1 align-items-end lh-1 p-2 rounded-pill pill-box" style="background-color: @waterColor;">
                            <div class="flex-grow-1 month-statistics-value">
                                <precipitation value="@precipSum" unit="@precipUnit"></precipitation>
                                <span> @precipUnit</span>
                            </div>
                        </div>
                    </div>
                    @{
                        int sunnyDays = dailyWeather.CloudCover.Count(cc => cc < 50);
                        int cloudyDays = dailyWeather.CloudCover.Count(cc => cc >= 50);
                        int rainyDays = dailyWeather.PrecipitationSum.Count(ps => ps > 0.3);
                        string grayLightColor = WeatherHelper.GetGrayLightColor();
                    }
                    <div class="d-flex justify-content-between text-center">
                        <div>
                            <span class="font-16">Sunny days</span>
                            <div class="flex-grow-1 rounded-pill lh-1 p-2 pill-box month-statistics-value" style="background-color: @grayLightColor;">
                                <span>@sunnyDays</span>
                            </div>
                        </div>
                        <div>
                            <span class="font-16">Cloudy days</span>
                            <div class="flex-grow-1 rounded-pill lh-1 p-2 pill-box month-statistics-value" style="background-color: @grayLightColor;">
                                <span>@cloudyDays</span>
                            </div>
                        </div>
                        <div>
                            <span class="font-16">Rainy days</span>
                            <div class="flex-grow-1 rounded-pill lh-1 p-2 pill-box month-statistics-value" style="background-color: @grayLightColor;">
                                <span>@rainyDays</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="month-right">
                <div class="d-grid month-grid">
                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>
                    <span class="weekday-text">Sat</span>
                    <span class="weekday-text">Sun</span>
                </div>
                <div class="d-grid pt-1 month-grid">
                    @for (int day = -pastDays; day < days; day++)
                    {
                        var dayWeather = Model.DailyWeatherData.GetSingleDayWeather(localNow.AddDays(day));
                        string tempColor = "transparent";
                        if (day >= 0)
                        {
                            tempColor = WeatherHelper.GetTemperatureColor(dayWeather.TemperatureMax);
                        }
                        var svgPair = WeatherHelper.GetWeatherSvgPair(dayWeather.Code);
                        var weatherDescription = WeatherHelper.GetWeatherDescription(dayWeather.Code);

                        <a asp-action="Day" asp-route-city="@locationWithId" asp-route-day="@day" class="text-decoration-none text-black d-block month-cell @(day < 0 ? "gray-out" : "")" style="background-color: @(tempColor);">
                            <div class="h-100 w-100 px-1 pt-0 pb-1 d-flex flex-column month-cell-overlay">
                                <span class="font-16">
                                    <date date="@dayWeather.Time.Date" format="day"></date>
                                </span>
                                <div class="d-flex justify-content-between flex-grow-1">
                                    <div class="text-center" title="@weatherDescription">
                                        <div>
                                            <img src="~/svg/weather/@($"{svgPair.Clouds} d").svg" width="50" />
                                        </div>
                                        <div>
                                            <img src="~/svg/weather/@($"{svgPair.Precipitation}").svg" width="32" />
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column justify-content-end">
                                        <span class="font-20">
                                            <temperature value="@dayWeather.TemperatureMax" unit="@temperatureUnit"></temperature>
                                        </span>
                                        <div class="d-flex justify-content-end">
                                            <span class="month-cell-temp-min">
                                                <temperature value="@dayWeather.TemperatureMin" unit="@temperatureUnit"></temperature>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                    @for (int i = 0; i < trailingEmptyCells; i++)
                    {
                        <div class="px-1 pt-0 pb-1 font-16 month-cell">
                            <date date="@localNow.AddDays(i + days).Date" format="day"></date>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>