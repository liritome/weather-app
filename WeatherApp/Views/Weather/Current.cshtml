@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoData

@{
    DateTime now = DateTime.Now;
    DailyWeather weatherToday = Model.DailyWeatherData.GetDailyWeatherByDate(now);
    DateTime sunrise = weatherToday.Sunrise;
    DateTime sunset = weatherToday.Sunset;
    double sunAngle = WeatherHelper.GetSunAngle(now, sunrise, sunset);
}

<div class="p-2 rounded bg-white my-2">
    <div class="d-flex flex-column text-white text-center" style="background-color:#4e99e4">
        <div class="my-3" style="font-size: 20px">
            @now.ToString("ddd, dd MMMM, HH:mm")
        </div>
        <div class="position-relative">
            <div class="position-absolute top-50 start-50" style="transform: translate(-50%, 33%)">
                <div class="lh-1 mb-3" style="font-size: 120px; font-weight: 500; letter-spacing: -5px;">
                    <temperature value="@Model.CurrentWeatherData.Temperature"></temperature>
                </div>
                <div class="d-inline-flex py-1 px-2 rounded" style="font-size: 18px; background-color:rgba(255, 255, 255, 0.10);">
                    Feels like&nbsp;
                    <temperature value="@Model.CurrentWeatherData.ApparentTemperature"></temperature>
                </div>
                <div style="font-size: 32px;">@Model.CurrentWeatherData.WeatherDescription</div>
            </div>
        </div>
        <div class="d-flex justify-content-center gap-2 mb-3">
            <div class="d-flex flex-column justify-content-center">
                <div>@sunrise.ToString("HH:mm")</div>
                <div>Sunrise</div>
            </div>
            <div>
                <div style="background-image: url('/svg/sun.svg'); background-size: 380px 380px; transform: rotate(@(sunAngle)deg); width: 380px; height: 380px;"></div>
            </div>
            <div class="d-flex flex-column justify-content-center">
                <div>@sunset.ToString("HH:mm")</div>
                <div>Sunset</div>
            </div>
        </div>
        <div class="py-3 d-flex justify-content-around text-start" style="background-color:rgba(0, 0, 0, 0.10);">
            <div>
                <div style="font-size: 16px;">Wind</div>
                <div class="d-flex align-items-end lh-1">
                    <div style="font-size: 32px; font-weight: 500;">@Model.CurrentWeatherData.WindSpeed</div>
                    <div class="ms-1" style="font-size: 16px; margin-bottom: 1.7px;">m/s @Model.CurrentWeatherData.WindDirection</div>
                </div>
            </div>
            <div>
                <div style="font-size: 16px;">Pressure</div>
                <div class="d-flex align-items-end lh-1">
                    <div style="font-size: 32px; font-weight: 500;">@Model.CurrentWeatherData.Pressure</div>
                    <div class="ms-1" style="font-size: 16px; margin-bottom: 1.7px;">mm Hg</div>
                </div>
            </div>
            <div>
                <div style="font-size: 16px;">Humidity</div>
                <div class="d-flex align-items-end lh-1">
                    <div style="font-size: 32px; font-weight: 500;">@Model.CurrentWeatherData.Humidity</div>
                    <div class="ms-1" style="font-size: 16px; margin-bottom: 1.7px;">%</div>
                </div>
            </div>
            <div>
                <div style="font-size: 16px;">Precipitation</div>
                <div class="d-flex align-items-end lh-1">
                    <div style="font-size: 32px; font-weight: 500;">@Model.CurrentWeatherData.Presipitation</div>
                    <div class="ms-1" style="font-size: 16px; margin-bottom: 1.7px;">mm</div>
                </div>
            </div>
            <div>
                <div style="font-size: 16px;">Clouds</div>
                <div class="d-flex align-items-end lh-1">
                    <div style="font-size: 32px; font-weight: 500;">@Model.CurrentWeatherData.CloudCover</div>
                    <div class="ms-1" style="font-size: 16px; margin-bottom: 1.7px;">%</div>
                </div>
            </div>
        </div>
    </div>
</div>