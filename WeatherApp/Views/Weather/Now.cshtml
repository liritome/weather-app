@using WeatherApp.Models
@using WeatherApp.Helpers

@model WeatherApp.Models.OpenMeteoWeatherData

@{
    DateTime localNow = DateTime.UtcNow.AddSeconds(Model.UtcOffsetSeconds);
    SingleDayWeather weatherToday = Model.DailyWeatherData.GetSingleDayWeather(localNow);

    DateTime sunrise = weatherToday.Sunrise;
    DateTime sunset = weatherToday.Sunset;
    double sunAngle = WeatherHelper.GetSunAngle(localNow, sunrise, sunset);
    bool isDay = localNow >= sunrise && localNow <= sunset;

    CurrentWeatherData currentWeather = Model.CurrentWeatherData;
    WeatherConditionSvgPair weatherConditionPair = WeatherHelper.GetWeatherSvgPair(currentWeather.Code);
    string weatherImage = WeatherHelper.GetWeatherImage(currentWeather.Code);

    string windDirection = WeatherHelper.GetWindDirection(currentWeather.WindDirectionDegree);
    string weatherDescription = WeatherHelper.GetWeatherDescription(currentWeather.Code);

    string temperatureUnit = Context.Request.Cookies["temperatureUnit"] ?? WeatherHelper.DefaultTemperatureUnit;
    string speedUnit = Context.Request.Cookies["speedUnit"] ?? WeatherHelper.DefaultSpeedUnit;
    string precipUnit = Context.Request.Cookies["precipUnit"] ?? WeatherHelper.DefaultPrecipUnit;
    string pressureUnit = Context.Request.Cookies["pressureUnit"] ?? WeatherHelper.DefaultPressureUnit;
}

<div class="container-fluid p-0 main-width">
    <div class="mt-2 mb-3 font-24">
        <div>
            Weather now
        </div>
    </div>

    <partial name="_DayTabs" model="Model" />

    <div class="p-2 rounded bg-white mb-2">
        <div class="d-flex text-white text-center rounded overflow-hidden" style="background-image: url('/images/weather/@($"{weatherImage} {(isDay ? "d" : "n")}").webp');">
            <div class="p-3 now-left">
                <div class="mb-2 font-20">
                    @localNow.ToString("ddd, dd MMMM, HH:mm")
                </div>
                <div>
                    <div>
                        <img src="~/svg/weather/@($"{weatherConditionPair.Clouds} {(isDay ? "d" : "n")}").svg" width="100" />
                    </div>
                    <div>
                        <img src="~/svg/weather/@(weatherConditionPair.Precipitation).svg" width="65" />
                    </div>
                </div>
                <div class="d-flex flex-column justify-content-center now-description">@weatherDescription</div>
                <div class="d-flex flex-column gap-3 text-start">
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Wind</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">
                                <wind-speed value="@currentWeather.WindSpeed" unit="@speedUnit"></wind-speed>
                            </div>
                            <div class="now-left-unit">@speedUnit</div>
                            <div class="now-wind-arrow">
                                <img src="~/svg/arrow.svg" width="25" style="transform: rotate(@(currentWeather.WindDirectionDegree)deg);" />
                            </div>
                            <div class="now-left-unit">@windDirection</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Wind gusts</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">
                                <wind-speed value="@currentWeather.WindGusts" unit="@speedUnit"></wind-speed>
                            </div>
                            <div class="now-left-unit">@speedUnit</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Pressure</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">
                                <pressure value="@currentWeather.Pressure" unit="@pressureUnit"></pressure>                                
                            </div>
                            <div class="now-left-unit">@pressureUnit</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Humidity</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">@currentWeather.Humidity</div>
                            <div class="now-left-unit">%</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Precipitation</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">
                                <precipitation value="@currentWeather.Precipitation" unit="@precipUnit"></precipitation>
                            </div>
                            <div class="now-left-unit">@precipUnit</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div class="font-16">Clouds</div>
                        <div class="d-flex gap-1 align-items-end lh-1">
                            <div class="now-left-value">@currentWeather.CloudCover</div>
                            <div class="now-left-unit">%</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="position-relative d-flex flex-column align-items-center flex-fill now-right-overlay">
                <div class="position-absolute d-flex gap-1 start-50 now-sun-container">
                    <div class="d-flex flex-column justify-content-center">
                        <div>@sunrise.ToString("HH:mm")</div>
                        <div>
                            <img src="~/svg/sunrise.svg" width="65" />
                        </div>
                    </div>
                    <div>
                        <div class="now-sun" style="transform: rotate(@(sunAngle)deg);"></div>
                    </div>
                    <div class="d-flex flex-column justify-content-center">
                        <div>@sunset.ToString("HH:mm")</div>
                        <div>
                            <img src="~/svg/sunset.svg" width="65" />
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-column justify-content-center flex-fill">
                    <div>
                        <div class="lh-1 mb-3 now-temperature">
                            <temperature value="@currentWeather.Temperature" unit="@temperatureUnit"></temperature>
                        </div>
                        <div class="d-inline-flex py-1 px-2 rounded now-feels-like">
                            Feels like&nbsp;
                            <temperature value="@currentWeather.ApparentTemperature" unit="@temperatureUnit"></temperature>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>