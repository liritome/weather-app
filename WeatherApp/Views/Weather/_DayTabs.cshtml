@using WeatherApp.Helpers

@model WeatherApp.ViewModels.DayTabsViewModel

@{
    var days = WeatherHelper.Days;
    int start = -1;
    if(Model.DayNumber < 0)
    {
        start = 0;
    }
    if(Model.DayNumber > 11)
    {
        start = 10 - Model.DayNumber;
    }
    int end = start + 4;
}

<div class="d-flex gap-2">
    @for (int i = start; i < end; i++)
    {
        var day = Model.OpenMeteoData.DailyWeatherData.GetDailyWeatherByDate(Model.DayDate.AddDays(i));

        <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="@(Model.DayNumber + i)" class="text-decoration-none text-black">
            <div class="p-2 mb-2 pt-1 rounded bg-white @(i == 0 && Context.Request.Query.ContainsKey("day") ? "active-day-tab" : "day-tab")">
                <div class="d-flex justify-content-between h-100">
                    <div class="d-flex flex-column me-2">
                        <div style="height: 24px; font-size: 20px">@Model.DayDate.AddDays(i).ToString("ddd, dd MMM")</div>
                        @{
                            var dayIndex = Model.DayNumber + i;
                            var dayLabel = days.ContainsKey(dayIndex) ? days[dayIndex] : "";
                        }
                        <div class="text-secondary" style="height: 20px;">@dayLabel</div>
                        <div class="flex-grow-1"></div>
                        <div class="d-flex" style="font-size: 24px">
                            <div class="text-center bg-success bg-opacity-50" style="width: 65px">
                                <temperature value="@day.TemperatureMin"></temperature>
                            </div>
                            <div class="text-center bg-success bg-opacity-75" style="width: 65px">
                                <temperature value="@day.TemperatureMax"></temperature>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-grow-1 text-center">
                        <div title="@day.WeatherDescription">
                            @{
                                var svgPair = WeatherHelper.GetWeatherSvg(day.Code);
                            }
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Condition} d").svg" width="65" />
                            </div>
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Precipitation}").svg" height="29" />
                            </div>
                        </div>
                        <div class="flex-grow-1"></div>
                        <div class="text-primary">@day.PrecipitationSum mm</div>
                    </div>
                </div>
            </div>
        </a>
    }
</div>