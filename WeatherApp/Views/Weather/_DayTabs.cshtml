@using WeatherApp.Helpers

@model WeatherApp.Models.OpenMeteoData

@{
    int dayNumber = (int)(ViewData["DayNumber"] ?? 0);
    DateTime dayDate = DateTime.Today.AddDays(dayNumber);
    var days = WeatherHelper.Days;

    int minDayIndex = days.Keys.First();
    int maxDayIndex = days.Keys.Last();
    int startDayIndex = -1;
    if (dayNumber < minDayIndex + 1)
    {
        startDayIndex = 0;
    }
    if (dayNumber > maxDayIndex - 2)
    {
        startDayIndex = maxDayIndex - 3 - dayNumber;
    }
    int endDayIndex = startDayIndex + 4;
}

<div class="d-flex gap-2">
    @for (int i = startDayIndex; i < endDayIndex; i++)
    {
        var day = Model.DailyWeatherData.GetDailyWeatherByDate(dayDate.AddDays(i));
        var svgPair = WeatherHelper.GetWeatherSvg(day.Code);

        <a asp-action="Day" asp-route-city="@ViewData["City"]" asp-route-day="@(dayNumber + i)" class="text-decoration-none text-black">
            <div class="p-2 mb-2 pt-1 rounded bg-white @(i == 0 && ViewData["DayNumber"] != null ? "active-day-tab" : "day-tab")">
                <div class="d-flex justify-content-between h-100">
                    <div class="d-flex flex-column me-2">
                        <div style="height: 24px; font-size: 20px">@dayDate.AddDays(i).ToString("ddd, dd MMM")</div>
                        @{
                            var dayIndex = dayNumber + i;
                            var dayLabel = days.ContainsKey(dayIndex) ? days[dayIndex] : "";
                        }
                        <div class="text-secondary" style="height: 20px;">@dayLabel</div>
                        <div class="flex-grow-1"></div>
                        <div class="d-flex" style="font-size: 24px">
                            @{
                                string tempMinColor = WeatherHelper.GetTemperatureColor(day.TemperatureMin);
                                string tempMaxColor = WeatherHelper.GetTemperatureColor(day.TemperatureMax);
                            }
                            <div class="text-center" style="width: 65px; background-color:@tempMinColor;">
                                <temperature value="@day.TemperatureMin"></temperature>
                            </div>
                            <div class="text-center" style="width: 65px; background-color:@tempMaxColor;">
                                <temperature value="@day.TemperatureMax"></temperature>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-grow-1 text-center">
                        <div title="@day.WeatherDescription">
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Condition} d").svg" width="65" />
                            </div>
                            <div>
                                <img src="~/svg/weather/@($"{svgPair.Precipitation}").svg" width="42" />
                            </div>
                        </div>
                        <div class="flex-grow-1"></div>
                        <div class="text-primary">@day.PrecipitationSum mm</div>
                    </div>
                </div>
            </div>
        </a>
    }
</div>