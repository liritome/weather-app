@using WeatherApp.Helpers
@using WeatherApp.Models

@model WeatherApp.Models.OpenMeteoData

@{
    HourlyWeather hourlyWeather = Model.HourlyWeatherData.GetHourlyWeatherByDate(DateTime.Today);
}

<div class="p-2 rounded bg-white mb-2">
    <div class="d-flex flex-row gap-1 justify-content-around">
        @for (int i = 0; i < hourlyWeather.Time.Count; i += 2)
        {
            <div>
                <span>@hourlyWeather.Time[i].ToString("HH:mm")</span>
            </div>
        }
    </div>
</div>